# ============================================================
# 复制本文件为 .env 并填入你自己的值:  cp .env.example .env
# （Windows:  copy .env.example .env）
# main.py 会优先从 .env 读取这些变量
# ============================================================

# 模型（DeepSeek 的 chat 模型，支持 function calling）
LLM_MODEL_ID=deepseek-chat

# 你的 DeepSeek API Key（必填，去 https://platform.deepseek.com 获取）
LLM_API_KEY=your_api_key_here

# DeepSeek 兼容 OpenAI 的接入点
LLM_BASE_URL=https://api.deepseek.com/v1

# 超时（秒）
LLM_TIMEOUT=60

# ---------- 其它 OpenAI 兼容服务示例（取消注释并修改即可）----------
# OpenAI:
# LLM_MODEL_ID=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# 硅基流动 SiliconFlow:
# LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# LLM_BASE_URL=https://api.siliconflow.cn/v1
