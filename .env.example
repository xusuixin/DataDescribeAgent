# ============================================================
# 复制本文件为 .env 并填入你自己的值:  cp .env.example .env
# （Windows:  copy .env.example .env）
# main.py 会优先从 .env 读取这些变量
# ============================================================

# 模型（ModelScope 上的 Qwen 系列，可改成你自己想用的）
LLM_MODEL_ID=Qwen/Qwen3-8B

# 你的 ModelScope API Key（必填，去 https://modelscope.cn 个人中心-访问令牌 获取）
LLM_API_KEY=your_api_key_here

# ModelScope 兼容 OpenAI 的接入点
LLM_BASE_URL=https://api-inference.modelscope.cn/v1/

# 超时（秒）
LLM_TIMEOUT=60
